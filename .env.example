==============================================================================
# DAILY MEAT BACKEND v2 (NestJS) - ENVIRONMENT VARIABLE DEFINITIONS & DOCUMENTATION
==============================================================================
# 1. SERVER & NETWORK
#    - PORT: Port where the NestJS HTTP & Socket.IO server listens (default: 3000).
#    - API_PREFIX: Global route prefix (default: api/v1).
#    - APP_BASE_URL: Public domain of the backend; used to build the payment webhook callback URL.
#    - CORS_ORIGINS: Comma separated allowed origins (empty = allow any).
#    - SWAGGER_ENABLED: Serves /docs/customer, /docs/admin, /docs/driver.
#
# 2. DATABASE (PostgreSQL / Supabase) & CACHE
#    - DATABASE_URL: PostgreSQL URI. Hosted DBs: append ?sslmode=require (pooler: &pgbouncer=true&connection_limit=10).
#    - REDIS_URL: Optional. Without it cache + OTPs live in process memory (single instance only).
#
# 3. CASHFREE PAYMENT GATEWAY
#    - CASHFREE_ENV: 'PROD' for live payments, 'TEST' for sandbox.
#    - CASHFREE_APP_ID / CASHFREE_SECRET_KEY: Merchant credentials; the secret also verifies webhook signatures.
#
# 4. AUTHENTICATION & JWT SECRETS
#    - JWT_SECRET / JWT_EXPIRES_IN: Access token signing key and lifetime (REST + WebSockets).
#    - REFRESH_TOKEN_SECRET / REFRESH_TOKEN_EXPIRES_IN: Refresh token key and lifetime (refresh tokens rotate).
#
# 5. PUSH NOTIFICATIONS (Expo)
#    - EXPO_ACCESS_TOKEN, ANDROID_* channels, PUSH_TOKEN_MAX_CHARS (see below).
#    - FIREBASE_SERVICE_ACCOUNT_BASE64 from v1 is NOT used in v2 (pushes go through Expo).
#
# 6. TRANSACTIONAL EMAIL (Zoho SMTP)   - SMTP_HOST/PORT/USER/PASS/FROM
# 7. SMS FORTIUS GATEWAY (OTP SMS)     - SMS_FORTIUS_API_KEY/SENDER_ID/TEMPLATE_ID/BASE_URL
#
# 8. ASSET STORAGE (Supabase S3 protocol, any S3-compatible service)
#    - AWS_REGION / AWS_ENDPOINT / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
#    - S3_BUCKET (v1: AWS_S3_BUCKET_NAME), S3_PUBLIC_BASE_URL (public URL prefix stored with each image).
#    - S3_KYC_BUCKET: a PRIVATE bucket for new drivers' Aadhaar / selfie photos (never given a public URL).
#    - Cloudinary / STORAGE_PROVIDER from v1 are NOT used in v2 (S3-compatible only).
#
#    Own storage on the VPS (MinIO, see DEPLOY.md "Own image storage"):
#      AWS_ENDPOINT=http://minio:9000   AWS_REGION=us-east-1   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY = the MinIO login
#      S3_BUCKET=dailymeat (public images)   S3_KYC_BUCKET=dailymeat-kyc (private)
#      S3_PUBLIC_BASE_URL=https://img.dailymeat.in/dailymeat   (NO quotes, NO spaces)   MINIO_DATA_DIR=./minio-data
#
# 9. BUSINESS RULES (new in v2) - COD_MAX_AMOUNT, OTP_*, MAX_ACCOUNTS_PER_DEVICE, TEST_ACCOUNT_*,
#    DRIVER_DEPOSIT_*, DIGILOCKER_*, STAFF_*_DEFAULT_PASSWORD.
==============================================================================


==============================================================================
# ACTIVE ENVIRONMENT VARIABLES
==============================================================================

# Server
PORT=3100
API_PREFIX=api/v1
APP_BASE_URL=https://localhost:3100
# CORS_ORIGINS=
SWAGGER_ENABLED=true
NODE_ENV=development

# Database (PostgreSQL / Supabase) - LOCAL copy of prod data (container dm-v2-pg)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/daily_meat

# Cashfree Payments
CASHFREE_ENV=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Authentication & JWT Secrets
JWT_SECRET=
JWT_EXPIRES_IN=
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=

# Email (Zoho SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=noreply@dailymeat.in
SMTP_PASS=
SMTP_FROM='"Daily Meat" <noreply@dailymeat.in>'

# SMS Fortius
SMS_FORTIUS_API_KEY=
SMS_FORTIUS_SENDER_ID=DMMEAT
SMS_FORTIUS_TEMPLATE_ID=
SMS_FORTIUS_BASE_URL=
# "Come back to Daily Meat" SMS: every Sunday 8:00 AM IST, APP_REMINDER_SMS_PER_RUN customers who are active but have no
# push device (app uninstalled) and have not opened the app for APP_REMINDER_SMS_INACTIVE_DAYS days. A customer is
# reminded again after ceil(eligible / per run) weeks (800 eligible, 50 per run = 16 weeks). Every send is logged in
# reminder_sms_logs. Runs in production (or with SCHEDULED_NOTIFICATIONS_ENABLED=true).
SMS_FORTIUS_APP_REMINDER_TEMPLATE_ID=
APP_REMINDER_SMS_ENABLED=
APP_REMINDER_SMS_INACTIVE_DAYS=
APP_REMINDER_SMS_PER_RUN=

# S3 Configuration (Supabase S3 Protocol)
AWS_REGION=
AWS_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET="Daily Meat"
S3_PUBLIC_BASE_URL=
# Private bucket for driver KYC photos (Aadhaar front/back, selfie). Empty = S3_BUCKET above (keys under kyc/).
# Use a bucket that is NOT public: the photos are only read back through the admin API.
S3_KYC_BUCKET=

# Android notification channel for order alerts (created by the app; has a sound and pops on screen)
ANDROID_NOTIFICATION_CHANNEL_ID=

# App upgrade prompt: latest build number published on each store (bump after each release)
APP_ANDROID_LATEST_BUILD=
APP_ANDROID_STORE_URL=
APP_IOS_LATEST_BUILD=
APP_IOS_STORE_URL=

# Optional: only if "enhanced push security" is enabled on the Expo project
# EXPO_ACCESS_TOKEN=

# Optional tuning (defaults shown)
ANDROID_ALARM_CHANNEL_ID=
PUSH_TOKEN_MAX_CHARS=

# Redis cache. Local dev: leave REDIS_URL empty to run without a cache.
# REDIS_URL=redis://localhost:6379

# Optional: the customer gets "your delivery partner has arrived" when the driver is within this many metres (default 150)
ARRIVAL_RADIUS_METERS=

# Business rules & OTP (new in v2; defaults shown)
# Cash on Delivery is refused above this order total, and it is the limit for carrying on as COD after a failed
# online payment (default 3000)
COD_MAX_AMOUNT=
OTP_TTL_SECONDS=
OTP_MAX_ATTEMPTS=
MAX_ACCOUNTS_PER_DEVICE=
# Store-reviewer test account: any phone containing this marker signs in with the fixed OTP below, no SMS sent
TEST_ACCOUNT_PHONE_MARKER=
TEST_ACCOUNT_OTP=

# New driver starting deposit (T-shirt + basket): the list price (shown struck out) and the offer price charged.
# Defaults 2000 / 1500 (shown as 25% off)
DRIVER_DEPOSIT_LIST_PRICE=
DRIVER_DEPOSIT_PRICE=

# DigiLocker (Aadhaar e-KYC) for new drivers. Leave empty to keep it off: drivers then upload the Aadhaar photos
# and an admin checks them. Needs DigiLocker partner credentials and the approved redirect URL.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=

# Starting passwords the super admin's "Reset password" / "Add number" give to Admin and Driver accounts
# (defaults DAS@3781 / Dvr@7939; set your own in production and tell the staff to change them)
STAFF_ADMIN_DEFAULT_PASSWORD=
STAFF_DRIVER_DEFAULT_PASSWORD=

# General marketing push: the admin "Marketing Broadcast" to customers and the scheduled plans. Set to false to stop
# all of it (nothing is counted or sent, the admin sees "turned off"). Order / driver alerts and admin previews still
# work. Default true.
MARKETING_PUSH_ENABLED=

# Automatic customer reminders (each is on unless set to false; MARKETING_PUSH_ENABLED=false also stops them).
# Only run in production, or elsewhere when SCHEDULED_NOTIFICATIONS_ENABLED=true.
# "Promotional Offers": Sun / Wed / Fri 7-8 AM and 10:30-11:30 AM IST - reorder reminders, new-customer intro and offers
PROMO_REMINDERS_ENABLED=true
# "Tomorrow's Plan": every day 7 PM and 10 PM IST - ask customers with no order today to pre-book for tomorrow
TOMORROW_PLAN_REMINDER_ENABLED=true
# false = send the Tomorrow's Plan push only to customers who cancelled today's order (default: all customers)
TOMORROW_PLAN_ALL_CUSTOMERS=true
