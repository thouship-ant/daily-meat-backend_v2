==============================================================================
# DAILY MEAT BACKEND v2 (NestJS) - ENVIRONMENT VARIABLE DEFINITIONS & DOCUMENTATION
==============================================================================
# 1. SERVER & NETWORK
#    - PORT: Port where the NestJS HTTP & Socket.IO server listens (default: 3000).
#    - API_PREFIX: Global route prefix (default: api/v1).
#    - APP_BASE_URL: Public domain of the backend; used to build the payment webhook callback URL.
#    - CORS_ORIGINS: Comma separated allowed origins (empty = allow any).
#    - SWAGGER_ENABLED: Serves /docs/customer, /docs/admin, /docs/driver.
#
# 2. DATABASE (PostgreSQL / Supabase) & CACHE
#    - DATABASE_URL: PostgreSQL URI. Hosted DBs: append ?sslmode=require (pooler: &pgbouncer=true&connection_limit=10).
#    - REDIS_URL: Optional. Without it cache + OTPs live in process memory (single instance only).
#
# 3. CASHFREE PAYMENT GATEWAY
#    - CASHFREE_ENV: 'PROD' for live payments, 'TEST' for sandbox.
#    - CASHFREE_APP_ID / CASHFREE_SECRET_KEY: Merchant credentials; the secret also verifies webhook signatures.
#
# 4. AUTHENTICATION & JWT SECRETS
#    - JWT_SECRET / JWT_EXPIRES_IN: Access token signing key and lifetime (REST + WebSockets).
#    - REFRESH_TOKEN_SECRET / REFRESH_TOKEN_EXPIRES_IN: Refresh token key and lifetime (refresh tokens rotate).
#
# 5. PUSH NOTIFICATIONS (Expo)
#    - EXPO_ACCESS_TOKEN, ANDROID_* channels, PUSH_TOKEN_MAX_CHARS (see below).
#    - FIREBASE_SERVICE_ACCOUNT_BASE64 from v1 is NOT used in v2 (pushes go through Expo).
#
# 6. TRANSACTIONAL EMAIL (Zoho SMTP)   - SMTP_HOST/PORT/USER/PASS/FROM
# 7. SMS FORTIUS GATEWAY (OTP SMS)     - SMS_FORTIUS_API_KEY/SENDER_ID/TEMPLATE_ID/BASE_URL
#
# 8. ASSET STORAGE (Supabase S3 protocol, any S3-compatible service)
#    - AWS_REGION / AWS_ENDPOINT / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
#    - S3_BUCKET (v1: AWS_S3_BUCKET_NAME), S3_PUBLIC_BASE_URL (public URL prefix stored with each image).
#    - Cloudinary / STORAGE_PROVIDER from v1 are NOT used in v2 (S3-compatible only).
#
# 9. BUSINESS RULES (new in v2) - COD_MAX_AMOUNT, OTP_*, MAX_ACCOUNTS_PER_DEVICE, TEST_ACCOUNT_*.
==============================================================================


==============================================================================
# ACTIVE ENVIRONMENT VARIABLES
==============================================================================

# Server
PORT=3100
API_PREFIX=api/v1
APP_BASE_URL=https://localhost:3100
# CORS_ORIGINS=
SWAGGER_ENABLED=true
NODE_ENV=development

# Database (PostgreSQL / Supabase) - LOCAL copy of prod data (container dm-v2-pg)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/daily_meat

# Cashfree Payments
CASHFREE_ENV=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Authentication & JWT Secrets
JWT_SECRET=
JWT_EXPIRES_IN=
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=

# Email (Zoho SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=noreply@dailymeat.in
SMTP_PASS=
SMTP_FROM='"Daily Meat" <noreply@dailymeat.in>'

# SMS Fortius
SMS_FORTIUS_API_KEY=
SMS_FORTIUS_SENDER_ID=DMMEAT
SMS_FORTIUS_TEMPLATE_ID=
SMS_FORTIUS_BASE_URL=

# S3 Configuration (Supabase S3 Protocol)
AWS_REGION=
AWS_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET="Daily Meat"
S3_PUBLIC_BASE_URL=

# Android notification channel for order alerts (created by the app; has a sound and pops on screen)
ANDROID_NOTIFICATION_CHANNEL_ID=

# App upgrade prompt: latest build number published on each store (bump after each release)
APP_ANDROID_LATEST_BUILD=
APP_ANDROID_STORE_URL=
APP_IOS_LATEST_BUILD=
APP_IOS_STORE_URL=

# Optional: only if "enhanced push security" is enabled on the Expo project
# EXPO_ACCESS_TOKEN=

# Optional tuning (defaults shown)
ANDROID_ALARM_CHANNEL_ID=
PUSH_TOKEN_MAX_CHARS=

# Redis cache. Local dev: leave REDIS_URL empty to run without a cache.
# REDIS_URL=redis://localhost:6379

# Optional: the customer gets "your delivery partner has arrived" when the driver is within this many metres (default 150)
ARRIVAL_RADIUS_METERS=

# Business rules & OTP (new in v2; defaults shown)
# Cash on Delivery is refused above this order total
COD_MAX_AMOUNT=
OTP_TTL_SECONDS=
OTP_MAX_ATTEMPTS=
MAX_ACCOUNTS_PER_DEVICE=
# Store-reviewer test account: any phone containing this marker signs in with the fixed OTP below, no SMS sent
TEST_ACCOUNT_PHONE_MARKER=
TEST_ACCOUNT_OTP=
