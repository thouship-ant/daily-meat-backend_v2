# ---- Server ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_BASE_URL=http://localhost:3000        # public URL; used for the payment webhook callback
CORS_ORIGINS=                              # comma separated; empty = allow any origin
SWAGGER_ENABLED=true

# ---- Database / cache ----
# Add ?sslmode=require (and e.g. &connection_limit=10&pool_timeout=20) for hosted databases such as Supabase.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dailymeat
REDIS_URL=                                 # optional locally; without it cache/OTP live in process memory (single instance only)
REDIS_PASSWORD=                            # production compose only (openssl rand -hex 24); compose builds REDIS_URL from it

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-to-another-long-random-string
REFRESH_TOKEN_EXPIRES_IN=30d
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
MAX_ACCOUNTS_PER_DEVICE=2
TEST_ACCOUNT_PHONE_MARKER=                 # e.g. 9000000000 -> store-reviewer account with fixed OTP
TEST_ACCOUNT_OTP=123456

# ---- Business rules ----
COD_MAX_AMOUNT=2000
ARRIVAL_RADIUS_METERS=150

# ---- Payments (Cashfree) ----
CASHFREE_ENV=TEST                          # TEST | PROD
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# ---- OTP delivery ----
SMS_FORTIUS_API_KEY=
SMS_FORTIUS_SENDER_ID=
SMS_FORTIUS_TEMPLATE_ID=
SMS_FORTIUS_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Push (Expo) ----
EXPO_ACCESS_TOKEN=
ANDROID_ALARM_CHANNEL_ID=order-alarm
ANDROID_NOTIFICATION_CHANNEL_ID=
PUSH_TOKEN_MAX_CHARS=255                   # users.push_token is VARCHAR(255) in the existing schema

# ---- Image storage (any S3-compatible service) ----
S3_BUCKET=
S3_PUBLIC_BASE_URL=                        # e.g. https://cdn.example.com ; default is the bucket's S3 URL
AWS_REGION=
AWS_ENDPOINT=                              # for R2 / MinIO / Supabase
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- App store version gate ----
APP_ANDROID_LATEST_BUILD=0
APP_ANDROID_STORE_URL=
APP_IOS_LATEST_BUILD=0
APP_IOS_STORE_URL=
